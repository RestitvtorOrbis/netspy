<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Keep the shared source project consumable by every historical SDK. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SingleFile.Dependency</AssemblyName>
    <RootNamespace>SingleFile.Dependency</RootNamespace>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BundleValue.cs" />
  </ItemGroup>
</Project>
