<UserControl x:Class="dnSpy.MainApp.BrandMark"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsTabStop="False">
    <Viewbox Stretch="Uniform">
        <Border Width="64" Height="64" Background="#FF111827" CornerRadius="12">
            <Canvas Width="64" Height="64">
                <Polyline Points="14,45 14,25 32,14 50,25 50,45"
                          Fill="Transparent"
                          Stroke="#FF22D3EE"
                          StrokeThickness="6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                <Ellipse Canvas.Left="10" Canvas.Top="41" Width="8" Height="8"
                         Fill="#FFA78BFA" Stroke="#FFF8FAFC" StrokeThickness="2" />
                <Ellipse Canvas.Left="28" Canvas.Top="10" Width="8" Height="8"
                         Fill="#FFA78BFA" Stroke="#FFF8FAFC" StrokeThickness="2" />
                <Ellipse Canvas.Left="46" Canvas.Top="41" Width="8" Height="8"
                         Fill="#FFA78BFA" Stroke="#FFF8FAFC" StrokeThickness="2" />
            </Canvas>
        </Border>
    </Viewbox>
</UserControl>
